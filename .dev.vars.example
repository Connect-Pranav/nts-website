# Copy to .dev.vars for local `wrangler dev`. Never commit .dev.vars.
# Free key: Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=
# Dev Mode token (8+ characters). Production: npx wrangler secret put DEV_TOKEN
DEV_TOKEN=
# Free AI engines for running agents in Dev Mode (set at least one)
GEMINI_API_KEY=
GROQ_API_KEY=
