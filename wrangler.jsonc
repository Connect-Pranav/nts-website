{
  // NTS public site on Cloudflare Workers (free tier): static assets + /api/public/* (worker/site.mjs).
  // Secret (set with `npx wrangler secret put YOUTUBE_API_KEY`): YOUTUBE_API_KEY. Never commit it.
  "name": "nts",
  "main": "worker/site.mjs",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "YOUTUBE_HANDLE": "@NikhilsTechStudio"
  },
  "observability": { "enabled": true }
}
