{
  // NTS public site on Cloudflare Workers (free tier): static assets + /api/public/* (worker/site.mjs).
  // Secret (set with `npx wrangler secret put YOUTUBE_API_KEY`): YOUTUBE_API_KEY. Never commit it.
  "name": "nts-website",
  "main": "worker/site.mjs",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"]
  },
  // Dev Mode storage (settings + Brain). No id: Wrangler creates the namespace on first deploy.
  "kv_namespaces": [{ "binding": "NTS_KV" }],
  // Free Workers AI allowance: last-resort "cloud brain" when Gemini/Groq keys fail (daily-capped in code).
  "ai": { "binding": "AI" },
  // Agent team autopilot: one cycle every 6 hours (Workers cron triggers are free).
  "triggers": { "crons": ["17 */6 * * *", "5 * * * *"] },
  "vars": {
    "YOUTUBE_HANDLE": "@NikhilsTechStudio"
  },
  "observability": { "enabled": true }
}
